# Copy to .env and adjust as needed
PROJECT_NAME="Thyme API"
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL="postgresql+asyncpg://quraish@localhost:5432/life_tracker"
# Generate a strong value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY="dev-secret-change-me-in-production-0123456789abcdef"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Sign-In (SSO). OAuth 2.0 "Web application" client ID from Google Cloud
# Console. Public value — set the SAME id on the frontend as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. Blank disables /auth/google (returns 503).
GOOGLE_CLIENT_ID=""

# Web Push (VAPID). Generate a keypair (raw base64url) — the private key is a
# secret, keep it only in .env. The public key also goes in the frontend as
# NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Enable the background dispatcher that pushes due reminders (needs the keys).
PUSH_DISPATCH_ENABLED=false
PUSH_DISPATCH_INTERVAL_SECONDS=30

# AI features (structured extraction). Set the provider and supply its key; a
# missing key disables AI and the endpoints return 503. Gemini's flash tier is
# free (key at aistudio.google.com).
AI_PROVIDER="anthropic"   # "anthropic" | "gemini"
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
# Blank uses the provider's default model.
AI_MODEL=""
AI_MAX_OUTPUT_TOKENS=2048

# AI usage quota (MVP cost control). Regular users get this many AI calls total,
# shared across all AI features; then the endpoints return 429 until "upgrade".
AI_FREE_LIMIT=5
# Email of the account promoted to superadmin on startup (unlimited AI, for the
# maintainer's own testing). Blank = no superadmin.
SUPERADMIN_EMAIL=""
